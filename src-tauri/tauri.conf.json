{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grimm",
  "version": "0.5.0",
  "identifier": "com.deecaulcrick.grimm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grimm",
        "width": 1120,
        "height": 800,
        "minWidth": 520,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwMDExOTEyNjMzM0ZCODgKUldTSSt6TmpFaGtCQUJka092YXRjdDBYWElzTkZvS21sZlQrZC9BOGk5OUtrZWszK0VPRTR3WnoK",
      "endpoints": [
        "https://github.com/deecaulcrick/grimm-md/releases/latest/download/latest.json"
      ]
    }
  }
}
